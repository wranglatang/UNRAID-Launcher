{
  "name": "unraid-launcher",
  "version": "1.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A private, responsive launcher for your Unraid containers",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "8.7.5",
    "lucide-react": "^1.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "vite": "^6.4.1"
  }
}
