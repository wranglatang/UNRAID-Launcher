# Unraid WebGUI origin. /graphql is appended automatically.
UNRAID_URL=http://tower
# Keep this secret. Create a key with read access to Docker containers.
UNRAID_API_KEY=
# Authoritative hostname, without a scheme, path, or port.
# When set, this value is read-only in the app settings.
TAILSCALE_HOSTNAME=your-server.your-tailnet.ts.net
# Open http://your-server.your-tailnet.ts.net:9999
LAUNCHER_PORT=9999
# Explicit sample data for local preview only. Keep false on your server.
DEMO_MODE=false
# Optional: pin a published version or image digest instead of following latest.
# LAUNCHER_IMAGE=ghcr.io/wranglatang/unraid-launcher:1.0.1
